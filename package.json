{
  "name": "ai-monefy",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=client",
    "build": "npm run build --workspace=client",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check",
    "fix": "npm run format && npm run lint:fix",
    "client:lint": "npm run lint --workspace=client",
    "client:lint:fix": "npm run lint:fix --workspace=client",
    "client:format": "npm run format --workspace=client",
    "client:format:check": "npm run format:check --workspace=client",
    "test": "npm run test --workspace=client",
    "test:e2e": "npm run test:e2e --workspace=client",
    "test:coverage": "npm run test:coverage --workspace=client",
    "server:dev": "npm run dev --workspace=server",
    "server:build": "npm run build --workspace=server",
    "server:test": "npm run test --workspace=server",
    "server:lint": "npm run lint --workspace=server",
    "server:lint:fix": "npm run lint:fix --workspace=server",
    "server:format": "npm run format --workspace=server",
    "server:format:check": "npm run format:check --workspace=server"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.71.2"
  }
}

{
  "name": "ai-monefy-client",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint src e2e",
    "lint:fix": "eslint src e2e --fix",
    "format": "prettier --write src e2e",
    "format:check": "prettier --check src e2e",
    "check": "npm run lint && npm run format:check",
    "fix": "npm run format && npm run lint:fix",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:coverage": "rm -rf .nyc_output coverage-playwright && playwright test && nyc report"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "dexie": "^4.0.11",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-istanbul": "^3.2.7",
    "@vitest/coverage-v8": "^3.2.7",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^26.0.0",
    "nyc": "^18.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vite-plugin-istanbul": "^6.0.2",
    "vitest": "^3.0.5"
  }
}
